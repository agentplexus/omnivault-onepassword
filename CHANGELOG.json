{
  "irVersion": "1.0",
  "project": "omni-onepassword",
  "repository": "https://github.com/plexusone/omni-onepassword",
  "versioning": "semver",
  "commitConvention": "conventional",
  "maintainers": ["plexusone", "johncwang@gmail.com"],
  "releases": [
    {
      "version": "v0.4.0",
      "date": "2026-05-24",
      "commit": "a3cb425",
      "highlights": [
        { "description": "Auto-registration support for `op://` URI scheme via register package" }
      ],
      "added": [
        { "description": "`omnivault/register` package for automatic provider registration on import", "commit": "ec154df" },
        { "description": "Support for `omnivault.VaultFromURI(\"op://MyVault\")` without manual setup", "commit": "ec154df" }
      ],
      "dependencies": [
        { "description": "Update `github.com/plexusone/omnivault` from v0.3.0 to v0.5.0", "commit": "a3cb425" },
        { "description": "Update `golang.org/x/sys` from v0.43.0 to v0.45.0", "commit": "a3cb425" }
      ]
    },
    {
      "version": "v0.3.0",
      "date": "2026-05-03",
      "highlights": [
        { "description": "Renamed to `omni-onepassword` following the omni-<provider> pattern" },
        { "description": "Restructured as monorepo with `omnivault/` subdirectory" }
      ],
      "breaking": [
        { "description": "Module path changed from `github.com/plexusone/omnivault-onepassword` to `github.com/plexusone/omni-onepassword`" },
        { "description": "Import path changed to `github.com/plexusone/omni-onepassword/omnivault`" }
      ],
      "upgradeGuide": [
        { "description": "Update import paths from `github.com/plexusone/omnivault-onepassword` to `github.com/plexusone/omni-onepassword/omnivault`" },
        { "description": "Run `go get github.com/plexusone/omni-onepassword/omnivault@v0.3.0`" }
      ],
      "changed": [
        { "description": "Provider code moved to `omnivault/` subdirectory" },
        { "description": "Examples moved to `omnivault/examples/`" },
        { "description": "Integration name changed from `omnivault-onepassword` to `omni-onepassword`" }
      ],
      "documentation": [
        { "description": "Add root README.md following omni-aws pattern" },
        { "description": "Update omnivault/README.md with new import paths" }
      ]
    },
    {
      "version": "v0.2.0",
      "date": "2026-03-14",
      "highlights": [
        { "description": "Module migrated to new GitHub organization: `github.com/plexusone/omnivault-onepassword`" },
        { "description": "Updated for 1Password SDK v0.4.0 API breaking changes" }
      ],
      "breaking": [
        { "description": "Module path changed from `github.com/agentplexus/omnivault-onepassword` to `github.com/plexusone/omnivault-onepassword`", "commit": "84c7f51" }
      ],
      "upgradeGuide": [
        { "description": "Update import paths from `github.com/agentplexus/omnivault-onepassword` to `github.com/plexusone/omnivault-onepassword`" },
        { "description": "Run `go get github.com/plexusone/omnivault-onepassword@v0.2.0` to fetch new module" }
      ],
      "changed": [
        { "description": "SDK API calls updated from field access to method calls (`client.Items` to `client.Items()`)", "commit": "84c7f51" },
        { "description": "List operations changed from iterator pattern to direct slice returns", "commit": "84c7f51" }
      ],
      "dependencies": [
        { "description": "Update `github.com/plexusone/omnivault` from v0.2.2 to v0.3.0", "commit": "84c7f51" },
        { "description": "Maintain compatibility with `github.com/1password/onepassword-sdk-go` v0.4.0", "commit": "84c7f51" }
      ],
      "documentation": [
        { "description": "Update README badges and shields for new organization", "commit": "25de397" }
      ],
      "infrastructure": [
        { "description": "Migrate CI workflows to shared workflow references", "commit": "3501cc0" },
        { "description": "Rename workflows for consistency: `go-ci.yaml`, `go-lint.yaml`, `go-sast-codeql.yaml`", "commit": "6f9ec32" }
      ]
    },
    {
      "version": "v0.1.0",
      "date": "2026-01-11",
      "highlights": [
        { "description": "Initial release of OmniVault provider for 1Password" }
      ],
      "added": [
        { "description": "OmniVault `vault.Vault` interface implementation for 1Password", "commit": "51b4163" },
        { "description": "Full CRUD operations (Get, Set, Delete, Exists, List)", "commit": "51b4163" },
        { "description": "Batch operations support (GetBatch, SetBatch, DeleteBatch)", "commit": "51b4163" },
        { "description": "Multi-field item support with automatic field type inference", "commit": "51b4163" },
        { "description": "TOTP code generation and extraction", "commit": "51b4163" },
        { "description": "Flexible path formats including native `op://` references", "commit": "51b4163" },
        { "description": "Vault and item name-to-ID resolution with caching", "commit": "51b4163" },
        { "description": "Tag support with key:value formatting", "commit": "51b4163" },
        { "description": "Comprehensive error mapping to OmniVault error types", "commit": "51b4163" }
      ],
      "tests": [
        { "description": "Unit tests for conversion, path parsing, and configuration", "commit": "e6fffc0" },
        { "description": "Integration tests for 1Password provider operations", "commit": "e6fffc0" }
      ],
      "documentation": [
        { "description": "README with usage examples, path formats, and API reference", "commit": "8f54ec5" }
      ],
      "infrastructure": [
        { "description": "GitHub Actions CI workflow for testing and linting", "commit": "def96be" },
        { "description": "GolangCI-Lint configuration", "commit": "def96be" }
      ],
      "dependencies": [
        { "description": "Add `github.com/1password/onepassword-sdk-go` v0.4.0", "commit": "51b4163" },
        { "description": "Add `github.com/agentplexus/omnivault` v0.2.0", "commit": "74dca37" }
      ]
    }
  ]
}
